<Window x:Class="NMailClient.Poc.Views.PdfWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:i18n="clr-namespace:NMailClient.Poc.Services.I18n"
        xmlns:wv="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="{i18n:T Title.Pdf}" Icon="pack://application:,,,/NMailClient.Poc;component/Assets/appicon.ico"
        Height="860" Width="1080" MinHeight="520" MinWidth="700"
        WindowStartupLocation="CenterOwner" FontFamily="Segoe UI" FontSize="13"
        Background="{DynamicResource Bg}">

  <DockPanel>
    <DockPanel DockPanel.Dock="Bottom" Margin="10" LastChildFill="False">
      <Button DockPanel.Dock="Right" Content="{i18n:T Common.Close}" Padding="14,4" IsCancel="True" />
      <Button DockPanel.Dock="Right" Content="{i18n:T Pdf.SaveAs}" Padding="14,4" Margin="0,0,6,0"
              Click="Save_Click" />
      <Button DockPanel.Dock="Right" Content="{i18n:T Pdf.OpenExternal}" Padding="14,4" Margin="0,0,6,0"
              Click="OpenExternal_Click" />
      <TextBlock x:Name="LblInfo" VerticalAlignment="Center"
                 Foreground="{DynamicResource TextMuted}" TextTrimming="CharacterEllipsis" />
    </DockPanel>

    <wv:WebView2 x:Name="Viewer" />
  </DockPanel>
</Window>
