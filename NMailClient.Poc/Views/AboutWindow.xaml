<Window x:Class="NMailClient.Poc.Views.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:i18n="clr-namespace:NMailClient.Poc.Services.I18n"
        Title="{i18n:T Title.About}"
        Icon="pack://application:,,,/NMailClient.Poc;component/Assets/appicon.ico"
        Height="640" Width="860" MinHeight="520" MinWidth="720" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Bg}" FontFamily="Segoe UI" FontSize="13"
        TextOptions.TextFormattingMode="Display">

  <DockPanel Margin="18">

    <!-- Kopf: Logo, Name, Version -->
    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,16">
      <Image Source="pack://application:,,,/NMailClient.Poc;component/Assets/appicon.ico"
             Width="56" Height="56" VerticalAlignment="Top" Margin="0,0,14,0" />
      <StackPanel VerticalAlignment="Center">
        <TextBlock Text="N-MailClient" FontSize="21" FontWeight="SemiBold" />
        <TextBlock x:Name="LblVersion" Foreground="{DynamicResource TextMuted}" />
        <TextBlock x:Name="LblBuild" FontSize="11.5"
                   Foreground="{DynamicResource TextMuted}" />
      </StackPanel>
    </StackPanel>

    <!-- Fuss: Schaltflächen -->
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                HorizontalAlignment="Right" Margin="0,14,0,0">
      <Button Content="{i18n:T About.Project}" Padding="14,5" Margin="0,0,8,0" Click="Project_Click" />
      <Button Content="{i18n:T Common.Close}" Padding="18,5" IsCancel="True"
              Style="{StaticResource AccentButton}" />
    </StackPanel>

    <!-- Aktualisierung -->
    <Border DockPanel.Dock="Top" Padding="12,9" Margin="0,0,0,14" CornerRadius="4"
            Background="{DynamicResource Panel}"
            BorderBrush="{DynamicResource Border}" BorderThickness="1">
      <DockPanel>
        <Button DockPanel.Dock="Right" x:Name="BtnCheck" Content="{i18n:T About.Check}"
                Padding="14,4" Margin="10,0,0,0" Click="Check_Click" />
        <Button DockPanel.Dock="Right" x:Name="BtnOpenRelease" Content="{i18n:T About.OpenRelease}"
                Padding="14,4" Visibility="Collapsed" Click="Release_Click" />
        <TextBlock x:Name="LblUpdate" VerticalAlignment="Center" TextWrapping="Wrap"
                   Text="{i18n:T About.NotChecked}" />
      </DockPanel>
    </Border>

    <TabControl>
      <TabItem Header="{i18n:T About.Paths}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel x:Name="PathList" Margin="12" />
        </ScrollViewer>
      </TabItem>

      <TabItem Header="{i18n:T About.Components}">
        <DockPanel Margin="12">
          <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" FontSize="11.5"
                     Margin="0,0,0,8" Foreground="{DynamicResource TextMuted}"
                     Text="{i18n:T About.ComponentsExplain}" />
          <!-- Breiten so gewählt, dass die Summe in das Fenster passt: eine
               waagerechte Bildlaufleiste in einer Aufstellung ist ärgerlich. -->
          <ListView x:Name="PackageList" BorderThickness="0"
                    ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListView.ItemContainerStyle>
              <Style TargetType="ListViewItem">
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
              </Style>
            </ListView.ItemContainerStyle>
            <ListView.View>
              <GridView>
                <GridViewColumn Header="{i18n:T About.Component}" Width="215"
                                DisplayMemberBinding="{Binding Name}" />
                <GridViewColumn Header="{i18n:T About.Version}" Width="105"
                                DisplayMemberBinding="{Binding Version}" />
                <GridViewColumn Header="{i18n:T About.License}" Width="110"
                                DisplayMemberBinding="{Binding License}" />
                <GridViewColumn Header="{i18n:T About.Purpose}" Width="330">
                  <GridViewColumn.CellTemplate>
                    <DataTemplate>
                      <TextBlock Text="{Binding Purpose}" TextWrapping="Wrap" />
                    </DataTemplate>
                  </GridViewColumn.CellTemplate>
                </GridViewColumn>
              </GridView>
            </ListView.View>
          </ListView>
        </DockPanel>
      </TabItem>
    </TabControl>
  </DockPanel>
</Window>
