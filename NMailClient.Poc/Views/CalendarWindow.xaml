<Window x:Class="NMailClient.Poc.Views.CalendarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:i18n="clr-namespace:NMailClient.Poc.Services.I18n"
        Title="{i18n:T Title.Calendar}" Icon="pack://application:,,,/NMailClient.Poc;component/Assets/appicon.ico" Height="780" Width="1180" MinHeight="600" MinWidth="900"
        WindowStartupLocation="CenterOwner" FontFamily="Segoe UI" FontSize="13"
        Background="{DynamicResource Bg}">

  <DockPanel Margin="12">

    <!-- Kopfzeile -->
    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
      <Button Content="&lt;" Width="34" Padding="0,4" Click="Prev_Click" />
      <Button Content="{i18n:T Calendar.Today}" Padding="10,4" Margin="4,0" Click="Today_Click" />
      <Button Content="&gt;" Width="34" Padding="0,4" Click="Next_Click" />

      <TextBlock x:Name="LblPeriod" VerticalAlignment="Center" Margin="14,0,0,0"
                 FontSize="16" FontWeight="SemiBold" />

      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
        <ComboBox x:Name="CmbCalendars" Width="200" DisplayMemberPath="DisplayName"
                  Margin="0,0,8,0" SelectionChanged="Calendar_Changed" />
        <ToggleButton x:Name="TglMonth" Content="{i18n:T Calendar.Month}" Style="{StaticResource ToolToggle}"
                      Padding="10,4" IsChecked="True" Click="View_Click" Tag="month" />
        <ToggleButton x:Name="TglWeek" Content="{i18n:T Calendar.Week}" Style="{StaticResource ToolToggle}"
                      Padding="10,4" Click="View_Click" Tag="week" />
        <ToggleButton x:Name="TglList" Content="{i18n:T Calendar.List}" Style="{StaticResource ToolToggle}"
                      Padding="10,4" Click="View_Click" Tag="list" />
      </StackPanel>
    </DockPanel>

    <!-- Fusszeile -->
    <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
      <Button DockPanel.Dock="Right" Content="{i18n:T Common.Close}" Padding="14,4" IsCancel="True" />
      <Button DockPanel.Dock="Right" Content="{i18n:T Common.Delete}" Padding="14,4" Margin="0,0,6,0"
              Click="Delete_Click" />
      <Button DockPanel.Dock="Right" Content="{i18n:T Calendar.Edit}" Padding="14,4" Margin="0,0,6,0"
              Click="Edit_Click" />
      <Button DockPanel.Dock="Right" Content="{i18n:T Calendar.NewEvent}" Padding="14,4" Margin="0,0,6,0"
              Click="New_Click" Style="{StaticResource AccentButton}" />
      <TextBlock x:Name="LblInfo" VerticalAlignment="Center"
                 Foreground="{DynamicResource TextMuted}" TextTrimming="CharacterEllipsis" />
    </DockPanel>

    <Grid>
      <!-- Monat und Woche: Raster aus Tageskacheln -->
      <DockPanel x:Name="GridView">
        <UniformGrid DockPanel.Dock="Top" Columns="7" Margin="0,0,0,4">
          <TextBlock Text="Mo" FontWeight="SemiBold" HorizontalAlignment="Center" />
          <TextBlock Text="Di" FontWeight="SemiBold" HorizontalAlignment="Center" />
          <TextBlock Text="Mi" FontWeight="SemiBold" HorizontalAlignment="Center" />
          <TextBlock Text="Do" FontWeight="SemiBold" HorizontalAlignment="Center" />
          <TextBlock Text="Fr" FontWeight="SemiBold" HorizontalAlignment="Center" />
          <TextBlock Text="Sa" FontWeight="SemiBold" HorizontalAlignment="Center" />
          <TextBlock Text="So" FontWeight="SemiBold" HorizontalAlignment="Center" />
        </UniformGrid>

        <ItemsControl x:Name="DayGrid">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <UniformGrid Columns="7" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border BorderBrush="{DynamicResource Border}" BorderThickness="1"
                      Margin="1" Padding="4" MinHeight="86">
                <Border.Style>
                  <Style TargetType="Border">
                    <Setter Property="Background" Value="Transparent" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding InCurrentMonth}" Value="False">
                        <Setter Property="Opacity" Value="0.45" />
                      </DataTrigger>
                      <DataTrigger Binding="{Binding IsToday}" Value="True">
                        <Setter Property="Background" Value="{DynamicResource Selection}" />
                        <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </Border.Style>

                <DockPanel>
                  <TextBlock DockPanel.Dock="Top" Text="{Binding DayNumber}"
                             FontSize="11" Foreground="{DynamicResource TextMuted}"
                             HorizontalAlignment="Right" />

                  <ListBox ItemsSource="{Binding Items}" BorderThickness="0"
                           Background="Transparent" SelectionChanged="Item_Selected"
                           ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                      <DataTemplate>
                        <Border Background="{Binding Color}" CornerRadius="3"
                                Padding="4,1" Margin="0,1" ToolTip="{Binding RangeDisplay}">
                          <TextBlock Text="{Binding Summary}" Foreground="White"
                                     FontSize="11" TextTrimming="CharacterEllipsis" />
                        </Border>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                </DockPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </DockPanel>

      <!-- Listenansicht -->
      <ListView x:Name="ListView" Visibility="Collapsed"
                SelectionChanged="Item_Selected" MouseDoubleClick="Edit_Click"
                Background="Transparent" BorderBrush="{DynamicResource Border}"
                BorderThickness="1">
        <ListView.View>
          <GridView>
            <GridViewColumn Header="{i18n:T Calendar.Start}" Width="150" DisplayMemberBinding="{Binding Start, StringFormat='ddd dd.MM.yyyy'}" />
            <GridViewColumn Header="{i18n:T Calendar.Time}" Width="110" DisplayMemberBinding="{Binding TimeDisplay}" />
            <GridViewColumn Header="{i18n:T Calendar.Title}" Width="330" DisplayMemberBinding="{Binding Summary}" />
            <GridViewColumn Header="{i18n:T Calendar.Location}" Width="200" DisplayMemberBinding="{Binding Location}" />
          </GridView>
        </ListView.View>
      </ListView>
    </Grid>
  </DockPanel>
</Window>
