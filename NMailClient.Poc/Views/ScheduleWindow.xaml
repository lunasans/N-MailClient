<Window x:Class="NMailClient.Poc.Views.ScheduleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:i18n="clr-namespace:NMailClient.Poc.Services.I18n"
        Title="{i18n:T Title.Schedule}" Icon="pack://application:,,,/NMailClient.Poc;component/Assets/appicon.ico" SizeToContent="Height" Width="380"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False" FontFamily="Segoe UI" FontSize="13"
        Background="{DynamicResource Bg}">

  <StackPanel Margin="16">
    <TextBlock Text="{i18n:T Schedule.Quick}" Margin="0,0,0,6" />
    <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
      <Button Content="{i18n:T Main.Snooze.OneHour}" Padding="10,4" Margin="0,0,6,0" Tag="60" Click="Quick_Click" />
      <Button Content="{i18n:T Main.Snooze.Tonight}" Padding="10,4" Margin="0,0,6,0" Tag="evening" Click="Quick_Click" />
      <Button Content="{i18n:T Main.Snooze.Tomorrow}" Padding="10,4" Tag="morning" Click="Quick_Click" />
    </StackPanel>

    <TextBlock Text="{i18n:T Schedule.Date}" Margin="0,0,0,2" />
    <DatePicker x:Name="PickDate" Margin="0,0,0,10" />

    <TextBlock Text="{i18n:T Schedule.Time}" Margin="0,0,0,2" />
    <TextBox x:Name="TxtTime" Padding="6,4" Width="90" HorizontalAlignment="Left" />

    <TextBlock x:Name="LblError" Foreground="#C04F4F" TextWrapping="Wrap"
               Margin="0,8,0,0" Visibility="Collapsed" />

    <TextBlock Margin="0,12,0,0" TextWrapping="Wrap" FontSize="11"
               Foreground="{DynamicResource TextMuted}"
               Text="{i18n:T Schedule.Explain}" />

    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
      <Button Content="{i18n:T Schedule.Send}" Width="90" Margin="0,0,6,0" IsDefault="True"
              Click="Ok_Click" Style="{StaticResource AccentButton}" />
      <Button Content="{i18n:T Common.Cancel}" Width="90" IsCancel="True" />
    </StackPanel>
  </StackPanel>
</Window>
