<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Helles Farbschema. Schlüsselnamen sind in Dark.xaml identisch,
       damit sich die Dictionaries zur Laufzeit tauschen lassen. -->

  <SolidColorBrush x:Key="Bg"            Color="#FFFFFF" />
  <SolidColorBrush x:Key="Panel"         Color="#F5F6F8" />
  <SolidColorBrush x:Key="PanelAlt"      Color="#EDEFF2" />
  <SolidColorBrush x:Key="Border"        Color="#DCDFE4" />
  <SolidColorBrush x:Key="Text"          Color="#1F2328" />
  <SolidColorBrush x:Key="TextMuted"     Color="#6A737D" />
  <SolidColorBrush x:Key="Accent"        Color="#4A7DBD" />
  <SolidColorBrush x:Key="AccentHover"   Color="#3D6BA5" />
  <SolidColorBrush x:Key="OnAccent"      Color="#FFFFFF" />
  <SolidColorBrush x:Key="Selection"     Color="#E3ECF7" />
  <SolidColorBrush x:Key="Hover"         Color="#EEF1F5" />

  <!-- Ungelesene Zeile. Bewusst schwächer als 'Selection': beides trifft
       zusammen, und die Auswahl muss die stärkere Aussage bleiben. -->
  <SolidColorBrush x:Key="UnreadRow"     Color="#F2F6FB" />
  <SolidColorBrush x:Key="WarnBg"        Color="#FFF8E1" />
  <SolidColorBrush x:Key="WarnBorder"    Color="#E6D08A" />
  <SolidColorBrush x:Key="WarnText"      Color="#5C4708" />
  <SolidColorBrush x:Key="Star"          Color="#D9A400" />

  <!-- Zustandsfarben für Prüfergebnisse (SPF/DKIM/DMARC) -->
  <SolidColorBrush x:Key="OkBg"          Color="#E3F3E7" />
  <SolidColorBrush x:Key="OkBorder"      Color="#A9D6B6" />
  <SolidColorBrush x:Key="OkText"        Color="#2A6B3C" />
  <SolidColorBrush x:Key="BadBg"         Color="#FBE4E4" />
  <SolidColorBrush x:Key="BadBorder"     Color="#E0A3A3" />
  <SolidColorBrush x:Key="BadText"       Color="#A32B2B" />

  <!-- Von HtmlSanitizer für die Mailanzeige gelesen. -->
  <Color x:Key="HtmlBgColor">#FFFFFF</Color>
  <Color x:Key="HtmlFgColor">#1F2328</Color>

</ResourceDictionary>
