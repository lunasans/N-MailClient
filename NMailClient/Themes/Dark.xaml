<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Dunkles Farbschema. Schlüsselnamen identisch zu Light.xaml. -->

  <SolidColorBrush x:Key="Bg"            Color="#1C1F24" />
  <SolidColorBrush x:Key="Panel"         Color="#22262C" />
  <SolidColorBrush x:Key="PanelAlt"      Color="#2A2F36" />
  <SolidColorBrush x:Key="Border"        Color="#363C44" />
  <SolidColorBrush x:Key="Text"          Color="#E6E9EE" />
  <SolidColorBrush x:Key="TextMuted"     Color="#9AA4B1" />
  <SolidColorBrush x:Key="Accent"        Color="#5B93D8" />
  <SolidColorBrush x:Key="AccentHover"   Color="#6EA3E5" />
  <SolidColorBrush x:Key="OnAccent"      Color="#FFFFFF" />
  <SolidColorBrush x:Key="Selection"     Color="#2F3E52" />
  <SolidColorBrush x:Key="Hover"         Color="#2A2F36" />

  <!-- Ungelesene Zeile. Bewusst schwächer als 'Selection': beides trifft
       zusammen, und die Auswahl muss die stärkere Aussage bleiben. -->
  <SolidColorBrush x:Key="UnreadRow"     Color="#252C35" />
  <SolidColorBrush x:Key="WarnBg"        Color="#3A3220" />
  <SolidColorBrush x:Key="WarnBorder"    Color="#6B5A2E" />
  <SolidColorBrush x:Key="WarnText"      Color="#E8D9A8" />
  <SolidColorBrush x:Key="Star"          Color="#E0B93C" />

  <!-- Zustandsfarben für Prüfergebnisse (SPF/DKIM/DMARC) -->
  <SolidColorBrush x:Key="OkBg"          Color="#1E3325" />
  <SolidColorBrush x:Key="OkBorder"      Color="#3B6B49" />
  <SolidColorBrush x:Key="OkText"        Color="#8FD3A3" />
  <SolidColorBrush x:Key="BadBg"         Color="#3A2224" />
  <SolidColorBrush x:Key="BadBorder"     Color="#7A3E42" />
  <SolidColorBrush x:Key="BadText"       Color="#F0A0A0" />

  <!-- Von HtmlSanitizer für die Mailanzeige gelesen. -->
  <Color x:Key="HtmlBgColor">#1C1F24</Color>
  <Color x:Key="HtmlFgColor">#E6E9EE</Color>

</ResourceDictionary>
