<Application x:Class="NMailClient.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:NMailClient.Views">
  <Application.Resources>
    <ResourceDictionary>

      <ResourceDictionary.MergedDictionaries>
        <!-- Index 0: Farbschema. Wird von ThemeManager zur Laufzeit ausgetauscht. -->
        <ResourceDictionary Source="Themes/Light.xaml" />
        <ResourceDictionary Source="Themes/Controls.xaml" />
      </ResourceDictionary.MergedDictionaries>

      <BooleanToVisibilityConverter x:Key="BoolToVis" />
      <local:CountToVisibilityConverter x:Key="CountToVis" />
      <local:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis" />
      <local:SpacingToMarginConverter x:Key="SpacingToMargin" />
      <local:CategoryNameConverter x:Key="CategoryName" />
      <local:CategoryIsSelectedConverter x:Key="CategoryIsSelected" />

    </ResourceDictionary>
  </Application.Resources>
</Application>
