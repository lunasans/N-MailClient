<Window x:Class="NMailClient.Views.ComposeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:i18n="clr-namespace:NMailClient.Services.I18n"
        Title="{i18n:T Title.Compose}" Icon="pack://application:,,,/NMailClient;component/Assets/appicon.ico" Height="720" Width="980" MinHeight="520" MinWidth="700"
        WindowStartupLocation="CenterOwner" FontFamily="Segoe UI" FontSize="13"
        Background="{DynamicResource Bg}" AllowDrop="True" Drop="Window_Drop">

  <DockPanel Margin="12">

    <!-- Vorschlagsliste der Empfänger; hängt sich an das jeweils aktive Feld -->
    <Popup x:Name="PopSuggest" StaysOpen="False" AllowsTransparency="True"
           Placement="Bottom" MinWidth="260" MaxHeight="220">
      <Border Background="{DynamicResource Bg}" BorderBrush="{DynamicResource Accent}"
              BorderThickness="1" CornerRadius="4" Padding="2">
        <ListBox x:Name="LstSuggest" BorderThickness="0" Background="Transparent"
                 MouseLeftButtonUp="Suggest_Click" KeyDown="Suggest_KeyDown">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <StackPanel Margin="4,2">
                <TextBlock Text="{Binding Label}" FontWeight="SemiBold" />
                <TextBlock Text="{Binding PrimaryEmail}" FontSize="11"
                           Foreground="{DynamicResource TextMuted}" />
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Border>
    </Popup>


    <Grid DockPanel.Dock="Top">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="70" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <TextBlock Grid.Row="0" Grid.Column="0" Text="{i18n:T Compose.From}" VerticalAlignment="Center" />
      <ComboBox Grid.Row="0" Grid.Column="1" x:Name="CmbFrom" Margin="0,4"
                DisplayMemberPath="Display" SelectionChanged="From_Changed" />

      <TextBlock Grid.Row="1" Grid.Column="0" Text="An" VerticalAlignment="Center" />
      <TextBox Grid.Row="1" Grid.Column="1" x:Name="TxtTo" Margin="0,4" Padding="4,3" />

      <TextBlock Grid.Row="2" Grid.Column="0" Text="Cc" VerticalAlignment="Center" />
      <TextBox Grid.Row="2" Grid.Column="1" x:Name="TxtCc" Margin="0,4" Padding="4,3" />

      <TextBlock Grid.Row="3" Grid.Column="0" Text="{i18n:T Compose.Bcc}" x:Name="LblBcc"
                 VerticalAlignment="Center" Visibility="Collapsed" />
      <TextBox Grid.Row="3" Grid.Column="1" x:Name="TxtBcc" Margin="0,4" Padding="4,3"
               Visibility="Collapsed" />

      <TextBlock Grid.Row="4" Grid.Column="0" Text="{i18n:T Common.Subject}" VerticalAlignment="Center" />
      <TextBox Grid.Row="4" Grid.Column="1" x:Name="TxtSubject" Margin="0,4" Padding="4,3" />

      <StackPanel Grid.Row="5" Grid.Column="1" Orientation="Horizontal" Margin="0,6,0,0">
        <ToggleButton x:Name="TglBcc" Content="{i18n:T Compose.Bcc}" Style="{StaticResource ToolToggle}"
                      Padding="8,3" Margin="0,0,8,0" Checked="Bcc_Toggled"
                      Unchecked="Bcc_Toggled" ToolTip="{i18n:T Compose.BccTip}" />
        <CheckBox x:Name="ChkReceipt" Content="{i18n:T Compose.Receipt}"
                  VerticalAlignment="Center" Margin="0,0,12,0"
                  ToolTip="{i18n:T Compose.ReceiptTip}" />
        <CheckBox x:Name="ChkSign" Content="{i18n:T Compose.Sign}" Visibility="Collapsed"
                  VerticalAlignment="Center" Margin="0,0,8,0" Click="Pgp_Toggled"
                  ToolTip="{i18n:T Compose.SignTip}" />
        <CheckBox x:Name="ChkEncrypt" Content="{i18n:T Compose.Encrypt}" Visibility="Collapsed"
                  VerticalAlignment="Center" Margin="0,0,12,0" Click="Pgp_Toggled"
                  ToolTip="{i18n:T Compose.EncryptTip}" />
        <ComboBox x:Name="CmbTemplates" Width="180" DisplayMemberPath="Name"
                  SelectionChanged="Template_Selected" ToolTip="{i18n:T Compose.TemplateTip}" />
        <Button Content="{i18n:T Compose.AsTemplate}" Padding="8,3" Margin="6,0,0,0"
                Click="SaveTemplate_Click" ToolTip="{i18n:T Compose.AsTemplateTip}" />
      </StackPanel>

      <!-- Transportsicherheit der Empfängerdomains; erscheint erst nach der Prüfung -->
      <TextBlock Grid.Row="6" Grid.Column="1" x:Name="LblTransport" Visibility="Collapsed"
                 FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0" />
    </Grid>

    <!-- Anhänge (Drag & Drop aufs Fenster oder Button) -->
    <Border DockPanel.Dock="Bottom" Margin="0,8,0,0">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
          <Button Content="{i18n:T Compose.Attach}" Padding="10,4" Margin="0,0,6,0" Click="Attach_Click" />
          <Button Content="{i18n:T Compose.Later}" Padding="10,4" Margin="0,0,6,0" Click="SendLater_Click"
                  ToolTip="{i18n:T Compose.LaterTip}" />
          <Button x:Name="BtnSend" Content="{i18n:T Compose.Send}" Padding="16,4" Click="Send_Click"
                  IsDefault="True" Style="{StaticResource AccentButton}" />
        </StackPanel>
        <TextBlock x:Name="LblAttachments" VerticalAlignment="Center"
                   Foreground="{DynamicResource TextMuted}" TextTrimming="CharacterEllipsis"
                   Text="{i18n:T Compose.NoAttachments}" />
      </DockPanel>
    </Border>

    <!-- Formatierleiste; Umfang bewusst auf das begrenzt, was der HTML-Konverter
         verlustfrei abbilden kann (siehe FlowDocumentHtml). -->
    <Border DockPanel.Dock="Top" Margin="0,10,0,0" Padding="4"
            Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Border}"
            BorderThickness="1" CornerRadius="4">
      <StackPanel Orientation="Horizontal">
        <Button Content="F" FontWeight="Bold" Width="30" Margin="0,0,2,0"
                ToolTip="{i18n:T Compose.Bold}" Command="EditingCommands.ToggleBold"
                CommandTarget="{Binding ElementName=TxtBody}" />
        <Button Content="K" FontStyle="Italic" Width="30" Margin="0,0,2,0"
                ToolTip="{i18n:T Compose.Italic}" Command="EditingCommands.ToggleItalic"
                CommandTarget="{Binding ElementName=TxtBody}" />
        <Button Width="30" Margin="0,0,2,0" ToolTip="{i18n:T Compose.Underline}"
                Command="EditingCommands.ToggleUnderline"
                CommandTarget="{Binding ElementName=TxtBody}">
          <TextBlock Text="U" TextDecorations="Underline" />
        </Button>
        <Button Width="30" Margin="0,0,8,0" ToolTip="{i18n:T Compose.Strike}"
                Click="Strike_Click">
          <TextBlock Text="S" TextDecorations="Strikethrough" />
        </Button>

        <Button Content="{i18n:T Compose.List}" Padding="8,3" Margin="0,0,2,0" ToolTip="{i18n:T Compose.Bullets}"
                Command="EditingCommands.ToggleBullets"
                CommandTarget="{Binding ElementName=TxtBody}" />
        <Button Content="1." Padding="8,3" Margin="0,0,2,0" ToolTip="{i18n:T Compose.Numbers}"
                Command="EditingCommands.ToggleNumbering"
                CommandTarget="{Binding ElementName=TxtBody}" />
        <Button Content="{i18n:T Compose.Quote}" Padding="8,3" Margin="0,0,8,0" ToolTip="{i18n:T Compose.QuoteTip}"
                Command="EditingCommands.IncreaseIndentation"
                CommandTarget="{Binding ElementName=TxtBody}" />

        <Button Content="{i18n:T Compose.Link}" Padding="8,3" Margin="0,0,8,0" Click="Link_Click"
                ToolTip="{i18n:T Compose.LinkTip}" />

        <ComboBox x:Name="CmbFontSize" Width="70" Margin="0,0,8,0"
                  SelectionChanged="FontSize_Changed" ToolTip="{i18n:T Compose.FontSize}" />

        <Button Content="{i18n:T Compose.ClearFormat}" Padding="8,3" Click="ClearFormat_Click" />
      </StackPanel>
    </Border>

    <RichTextBox x:Name="TxtBody" Margin="0,6,0,0" Padding="6"
                 VerticalScrollBarVisibility="Auto"
                 AcceptsTab="True" SpellCheck.IsEnabled="True" Language="de-DE"
                 Foreground="{DynamicResource Text}" Background="{DynamicResource Bg}"
                 BorderBrush="{DynamicResource Border}" BorderThickness="1"
                 FontFamily="Segoe UI" FontSize="14">
      <RichTextBox.Resources>
        <!-- WPF gibt jedem Absatz von sich aus einen grosszügigen Rand oben und
             unten; beim Schreiben einer Mail wirkt das zerrissen. Derselbe Wert
             steht im HTML-Wandler, damit die gesendete Mail so aussieht wie das,
             was hier stand. -->
        <Style TargetType="Paragraph">
          <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
      </RichTextBox.Resources>
    </RichTextBox>
  </DockPanel>
</Window>
