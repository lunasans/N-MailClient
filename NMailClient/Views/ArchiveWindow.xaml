<Window x:Class="NMailClient.Views.ArchiveWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:i18n="clr-namespace:NMailClient.Services.I18n"
        Title="{i18n:T Title.Archive}" Icon="pack://application:,,,/NMailClient;component/Assets/appicon.ico" Height="700" Width="1040" MinHeight="520" MinWidth="760"
        WindowStartupLocation="CenterOwner" FontFamily="Segoe UI" FontSize="13"
        Background="{DynamicResource Bg}">

  <DockPanel Margin="12">

    <!-- Werkzeugleiste -->
    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
      <Button DockPanel.Dock="Right" Content="{i18n:T Archive.OpenFolder}" Padding="10,4"
              Click="OpenFolder_Click" />
      <Button DockPanel.Dock="Right" Content="{i18n:T Archive.Refresh}" Padding="10,4" Margin="0,0,6,0"
              Click="Refresh_Click" />
      <ToggleButton DockPanel.Dock="Right" x:Name="TglGroup" Content="{i18n:T Archive.BySender}"
                    Style="{StaticResource ToolToggle}" Padding="10,4" Margin="0,0,6,0"
                    IsChecked="True" Checked="Group_Toggled" Unchecked="Group_Toggled"
                    ToolTip="{i18n:T Archive.BySenderTip}" />
      <TextBox x:Name="TxtSearch" Width="260" Padding="6,4" HorizontalAlignment="Left"
               TextChanged="Search_Changed"
               ToolTip="{i18n:T Archive.FilterTip}" />
    </DockPanel>

    <!-- Fusszeile -->
    <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
      <Button DockPanel.Dock="Right" Content="{i18n:T Common.Close}" Padding="14,4" IsCancel="True" />
      <Button DockPanel.Dock="Right" Content="{i18n:T Common.Delete}" Padding="14,4" Margin="0,0,6,0"
              Click="Delete_Click" />
      <Button DockPanel.Dock="Right" Content="{i18n:T Archive.Open}" Padding="14,4" Margin="0,0,6,0"
              Click="Open_Click" Style="{StaticResource AccentButton}" />
      <TextBlock x:Name="LblInfo" VerticalAlignment="Center"
                 Foreground="{DynamicResource TextMuted}" TextTrimming="CharacterEllipsis" />
    </DockPanel>

    <ListView x:Name="FileList" MouseDoubleClick="Open_Click"
              Background="Transparent" BorderBrush="{DynamicResource Border}" BorderThickness="1">

      <!-- Absender als Abschnittsüberschrift, einklappbar -->
      <ListView.GroupStyle>
        <GroupStyle>
          <GroupStyle.ContainerStyle>
            <Style TargetType="GroupItem">
              <Setter Property="Template">
                <Setter.Value>
                  <ControlTemplate TargetType="GroupItem">
                    <Expander IsExpanded="True" Margin="0,2,0,0"
                              Background="{DynamicResource Panel}">
                      <Expander.Header>
                        <StackPanel Orientation="Horizontal">
                          <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                          <TextBlock Text="{Binding ItemCount, StringFormat=' ({0})'}"
                                     Foreground="{DynamicResource TextMuted}" />
                        </StackPanel>
                      </Expander.Header>
                      <ItemsPresenter />
                    </Expander>
                  </ControlTemplate>
                </Setter.Value>
              </Setter>
            </Style>
          </GroupStyle.ContainerStyle>
        </GroupStyle>
      </ListView.GroupStyle>

      <ListView.View>
        <GridView>
          <GridViewColumn Header="{i18n:T Archive.File}" Width="320" DisplayMemberBinding="{Binding FileName}" />
          <GridViewColumn Header="{i18n:T Archive.Sender}" Width="260" DisplayMemberBinding="{Binding Sender}" />
          <GridViewColumn Header="{i18n:T Archive.Size}" Width="90" DisplayMemberBinding="{Binding SizeDisplay}" />
          <GridViewColumn Header="{i18n:T Archive.Filed}" Width="140" DisplayMemberBinding="{Binding ModifiedDisplay}" />
        </GridView>
      </ListView.View>
    </ListView>
  </DockPanel>
</Window>
