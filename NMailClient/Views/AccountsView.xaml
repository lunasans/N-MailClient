<UserControl x:Class="NMailClient.Views.AccountsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:i18n="clr-namespace:NMailClient.Services.I18n"
             FontFamily="Segoe UI" FontSize="13">

  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="200" />
      <ColumnDefinition Width="12" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <DockPanel Grid.Row="0" Grid.Column="0">
      <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
        <Button Content="{i18n:T Common.New}" Width="60" Margin="0,0,6,0" Click="New_Click" />
        <Button Content="{i18n:T Common.Remove}" Width="80" Click="Remove_Click" />
      </StackPanel>
      <ListBox x:Name="AccountList" DisplayMemberPath="Display"
               SelectionChanged="AccountList_SelectionChanged" />
    </DockPanel>

    <ScrollViewer Grid.Row="0" Grid.Column="2" VerticalScrollBarVisibility="Auto">
      <StackPanel x:Name="Editor">
        <TextBlock Text="{i18n:T Accounts.DisplayName}" Margin="0,0,0,2" />
        <TextBox x:Name="TxtName" Padding="4,3" Margin="0,0,0,8" />

        <TextBlock Text="{i18n:T Accounts.Email}" Margin="0,0,0,2" />
        <Grid Margin="0,0,0,8">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="6" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBox Grid.Column="0" x:Name="TxtEmail" Padding="4,3"
                   TextChanged="TxtEmail_TextChanged" />
          <Button Grid.Column="2" x:Name="BtnDiscover" Content="{i18n:T Accounts.DeepProbe}"
                  Padding="10,4" Click="Discover_Click"
                  ToolTip="{i18n:T Accounts.DeepProbeTip}" />
        </Grid>

        <TextBlock Text="{i18n:T Accounts.User}" Margin="0,0,0,2" />
        <TextBox x:Name="TxtUser" Padding="4,3" Margin="0,0,0,8" />

        <TextBlock Text="{i18n:T Accounts.Password}" Margin="0,0,0,2" />
        <PasswordBox x:Name="TxtPassword" Padding="4,3" Margin="0,0,0,8" />

        <Grid Margin="0,0,0,8">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="8" />
            <ColumnDefinition Width="80" />
          </Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0">
            <TextBlock Text="{i18n:T Accounts.ImapServer}" Margin="0,0,0,2" />
            <TextBox x:Name="TxtImapHost" Padding="4,3" />
          </StackPanel>
          <StackPanel Grid.Column="2">
            <TextBlock Text="{i18n:T Accounts.Port}" Margin="0,0,0,2" />
            <TextBox x:Name="TxtImapPort" Padding="4,3" />
          </StackPanel>
        </Grid>

        <Grid Margin="0,0,0,12">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="8" />
            <ColumnDefinition Width="80" />
          </Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0">
            <TextBlock Text="{i18n:T Accounts.SmtpServer}" Margin="0,0,0,2" />
            <TextBox x:Name="TxtSmtpHost" Padding="4,3" />
          </StackPanel>
          <StackPanel Grid.Column="2">
            <TextBlock Text="{i18n:T Accounts.Port}" Margin="0,0,0,2" />
            <TextBox x:Name="TxtSmtpPort" Padding="4,3" />
          </StackPanel>
        </Grid>

        <!-- Kennfarbe: unterscheidet die Konten in der Auswahl und im
             gemeinsamen Posteingang. -->
        <TextBlock Text="{i18n:T Accounts.Colour}" Margin="0,0,0,2" />
        <ComboBox x:Name="CmbColor" Width="220" HorizontalAlignment="Left"
                  Margin="0,0,0,10">
          <ComboBox.ItemTemplate>
            <DataTemplate>
              <StackPanel Orientation="Horizontal" Margin="2">
                <Border Width="12" Height="12" CornerRadius="6" Margin="0,0,8,0"
                        Background="{Binding}" />
                <TextBlock Text="{Binding}" />
              </StackPanel>
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>

        <TextBlock Text="{i18n:T Accounts.Signature}" Margin="0,0,0,2" />
        <TextBox x:Name="TxtSignature" Padding="4,3" Height="60"
                 AcceptsReturn="True" TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto" />

        <!-- Absender-Aliase -->
        <TextBlock Text="{i18n:T Accounts.Aliases}" FontSize="10.5" FontWeight="SemiBold"
                   Foreground="{DynamicResource TextMuted}" Margin="0,16,0,6" />

        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="180" />
            <ColumnDefinition Width="10" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>

          <DockPanel Grid.Column="0">
            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,6,0,0">
              <Button Content="{i18n:T Common.New}" Width="52" Margin="0,0,4,0" Click="AliasNew_Click" />
              <Button Content="{i18n:T Common.Remove}" Width="80" Click="AliasRemove_Click" />
            </StackPanel>
            <Grid Height="110">
              <ListBox x:Name="AliasList" DisplayMemberPath="Display"
                       SelectionChanged="AliasList_SelectionChanged" />
              <!-- Hinweis, solange die Liste leer ist -->
              <TextBlock x:Name="LblNoAliases" IsHitTestVisible="False"
                         Margin="8" TextWrapping="Wrap" FontSize="11"
                         Foreground="{DynamicResource TextMuted}"
                         Text="{i18n:T Accounts.Alias.Empty}" />
            </Grid>
          </DockPanel>

          <StackPanel Grid.Column="2" x:Name="AliasEditor">
            <TextBlock Text="{i18n:T Accounts.Alias.Address}" Margin="0,0,0,2" FontSize="12" />
            <TextBox x:Name="TxtAliasAddress" Padding="4,3" Margin="0,0,0,6"
                     TextChanged="AliasField_Changed" />

            <TextBlock Text="{i18n:T Accounts.Alias.DisplayName}" Margin="0,0,0,2" FontSize="12" />
            <TextBox x:Name="TxtAliasName" Padding="4,3" Margin="0,0,0,6"
                     TextChanged="AliasField_Changed" />

            <TextBlock Text="{i18n:T Accounts.Alias.Signature}" Margin="0,0,0,2" FontSize="12" />
            <TextBox x:Name="TxtAliasSignature" Padding="4,3" Height="44"
                     AcceptsReturn="True" TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto" TextChanged="AliasField_Changed" />
          </StackPanel>
        </Grid>

        <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" FontSize="11"
                   Foreground="{DynamicResource TextMuted}"
                   Text="{i18n:T Accounts.Alias.Explain}" />

        <!-- Kalender & Kontakte -->
        <TextBlock Text="{i18n:T Accounts.DavSection}" FontSize="10.5" FontWeight="SemiBold"
                   Foreground="{DynamicResource TextMuted}" Margin="0,16,0,6" />

        <TextBlock Text="{i18n:T Accounts.CardDav}" Margin="0,0,0,2" FontSize="12" />
        <Grid Margin="0,0,0,6">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="6" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBox Grid.Column="0" x:Name="TxtCardDav" Padding="4,3"
                   ToolTip="{i18n:T Accounts.CardDavTip}" />
          <Button Grid.Column="2" x:Name="BtnCardDav" Content="{i18n:T Accounts.CardDavSearch}"
                  Padding="10,4" Click="CardDav_Click" />
        </Grid>

        <TextBlock Text="{i18n:T Accounts.CalDav}" Margin="0,0,0,2" FontSize="12" />
        <TextBox x:Name="TxtCalDav" Padding="4,3" Margin="0,0,0,4"
                 ToolTip="{i18n:T Accounts.CalDavTip}" />

        <TextBlock Text="{i18n:T Accounts.SieveServer}" Margin="0,10,0,2" FontSize="12" />
        <Grid Margin="0,0,0,4">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="8" />
            <ColumnDefinition Width="70" />
          </Grid.ColumnDefinitions>
          <TextBox Grid.Column="0" x:Name="TxtSieveHost" Padding="4,3"
                   ToolTip="{i18n:T Accounts.SieveHostTip}" />
          <TextBox Grid.Column="2" x:Name="TxtSievePort" Padding="4,3"
                   ToolTip="{i18n:T Accounts.SievePortTip}" />
        </Grid>

        <TextBlock Text="{i18n:T Accounts.MailcowUrl}" Margin="0,10,0,2"
                   FontSize="12" />
        <TextBox x:Name="TxtMailcowUrl" Padding="4,3" Margin="0,0,0,4"
                 ToolTip="{i18n:T Accounts.MailcowUrlTip}" />

        <TextBlock Text="{i18n:T Accounts.MailcowKey}" Margin="0,0,0,2" FontSize="12" />
        <PasswordBox x:Name="TxtMailcowKey" Padding="4,3" Margin="0,0,0,4" />

        <TextBlock TextWrapping="Wrap" FontSize="11" Margin="0,0,0,4"
                   Foreground="{DynamicResource TextMuted}"
                   Text="{i18n:T Accounts.MailcowKeyExplain}" />

        <TextBlock TextWrapping="Wrap" FontSize="11"
                   Foreground="{DynamicResource TextMuted}"
                   Text="{i18n:T Accounts.Explain}" />

        <TextBlock x:Name="LblTest" Margin="0,8,0,0" TextWrapping="Wrap"
                   Foreground="{DynamicResource TextMuted}" />
      </StackPanel>
    </ScrollViewer>

    <StackPanel Grid.Row="1" Grid.Column="2" Orientation="Horizontal"
                HorizontalAlignment="Right" Margin="0,12,0,0">
      <Button Content="{i18n:T Accounts.Test}" Padding="10,4" Margin="0,0,6,0" Click="Test_Click" />
      <Button Content="{i18n:T Common.Save}" Padding="10,4" Click="Save_Click" />
    </StackPanel>
  </Grid>
</UserControl>
